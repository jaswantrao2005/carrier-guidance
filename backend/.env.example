# Server
PORT=5000
# Extra exact frontend origins, separated by commas. The local origins and
# https://carrier-guidance-two.vercel.app are always allowed by the API.
FRONTEND_ORIGINS=

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/careerai

# Secret used to sign JWTs. Use a long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Select Gemini or Groq. Gemini is the default when GEMINI_API_KEY is set.
AI_PROVIDER=gemini
# Create in Google AI Studio. Keep the real value only in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Groq alternative. Use AI_PROVIDER=groq to select it.
# Comma-separated keys are rotated automatically on rate limit.
GROQ_API_KEY=
# GROQ_API_KEYS=comma-separated-keys-if-needed

# Official public Judge0 endpoint. Requires internet and receives submitted code.
# Leave keys blank for this endpoint. See docs/CODING_SETUP.md for private/RapidAPI alternatives.
JUDGE0_API_KEY=
JUDGE0_URL=https://ce.judge0.com
JUDGE0_AUTH_TOKEN=

# Optional absolute persistent folder; default is backend/uploads.
# UPLOADS_DIR=C:/path/to/careerai-uploads

# Optional private Python service; configure its RECORDINGS_DIR with the shared upload directory.
INTEGRITY_SERVICE_URL=http://127.0.0.1:8001
